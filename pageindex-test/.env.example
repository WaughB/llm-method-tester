# Copy to .env and edit. Paths are HOST paths (Windows-style is fine).

# Storage roots — the locations selectable in the app's Settings page.
# PIT_ROOT_0 is required; PIT_ROOT_1 is optional (leave unset for one root).
# Examples:
#   PIT_ROOT_0=C:\Users\brett\Desktop\pageindex-data
#   PIT_ROOT_1=E:\pageindex-data
PIT_ROOT_0=
# PIT_ROOT_1=

# Ollama endpoint. Default reaches the HOST's Ollama from inside Docker.
# Requirements on Windows: run `setx OLLAMA_HOST 0.0.0.0` and restart Ollama,
# and allow inbound 11434 in Windows Defender Firewall if prompted.
# For the self-contained option run:  docker compose --profile local-ollama up -d
# and set:  PIT_OLLAMA_BASE_URL=http://ollama:11434
# PIT_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Models (must be pulled in whichever Ollama you use)
# PIT_DEFAULT_MODEL=llama3.1:8b
